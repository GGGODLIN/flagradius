# Optional settings for connecting the executor or diagnose to a separate Flagsmith sandbox.
# make demo generates its own disposable credentials and ignores .env files.
FLAGSMITH_API_URL=http://127.0.0.1:8000/api/v1/
FLAGSMITH_PROJECT_ID=1
FLAGSMITH_ENVIRONMENT_KEY=replace-me
FLAGSMITH_API_TOKEN=replace-me
FLAGRADIUS_ENVIRONMENT=sandbox
FLAGRADIUS_PROPOSAL_TOKEN=replace-with-local-proposal-token
FLAGRADIUS_HUMAN_APPROVAL_TOKEN=replace-with-distinct-operator-token
FLAGRADIUS_EXECUTOR_URL=http://127.0.0.1:8788
